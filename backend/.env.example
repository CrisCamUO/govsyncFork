# Entorno: development | test | production
ENVIRONMENT=development

# Conexión a PostgreSQL 16
# IMPORTANTE: el prefijo debe ser postgresql+psycopg://, no solo
# postgresql:// — el proyecto usa psycopg3 (ver requirements.txt), no
# psycopg2. Si copias la URL que Render genera automáticamente para su
# Postgres, agrega +psycopg manualmente después de postgresql antes de
# usarla.
DATABASE_URL=postgresql+psycopg://govsync:govsync@localhost:5432/govsync

# Clave de firma de los JWT. OBLIGATORIO cambiarla en producción.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-key-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Límites de carga de archivos.
# Solo .xlsx: la tarjeta [SEC-03] exige rechazar libros con macros (.xlsm).
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_SUFFIXES=.xlsx

# Código DANE del municipio piloto (Santa Rosa, Cauca)
MUNICIPIO_CODIGO_DANE=19701
